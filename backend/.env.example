# RosterIQ Backend Environment Configuration

# -------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# -------------------------------------------------------------
# Local SQLite (Default for offline local development):
DATABASE_URL=sqlite:///./rosteriq.db

# Hosted Supabase PostgreSQL:
# Option A: Direct Connection (Port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Option B: Transaction Pooler / Supavisor (Port 6543 - Recommended for serverless/cloud):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require

# -------------------------------------------------------------
# 2. RUNTIME ENVIRONMENT
# -------------------------------------------------------------
ENVIRONMENT=development
# Set to 'production' on Render
# ENVIRONMENT=production

PORT=8000
